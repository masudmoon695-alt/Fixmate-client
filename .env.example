# Next.js
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_IMGBB_API_KEY=

# ImageBB (server-side only, used by /api/upload-image)
IMGBB_API_KEY=
NEXT_PUBLIC_URL=http://localhost:3000

# BetterAuth (server-only)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Express API (server)
JWT_SECRET=

MONGODB_URI=
DB_NAME=

# Stripe (publishable key only, if used on the client; secret key stays on the server)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Comma-separated list of allowed origins for BetterAuth (e.g. http://localhost:3000,https://fixmate.vercel.app)
TRUSTED_ORIGINS=
